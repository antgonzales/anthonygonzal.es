---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import BaseLayout from "./BaseLayout.astro";
import { formatDate } from "../lib/formatDate";

interface Props {
  title: string;
  description?: string;
  pubDate: Date;
  updatedDate?: Date;
  heroImage?: ImageMetadata;
  previous?: { id: string; title: string };
  next?: { id: string; title: string };
}

const { title, description, pubDate, updatedDate, heroImage, previous, next } =
  Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  pubDate={pubDate}
  updatedDate={updatedDate}
  ogImage={heroImage?.src}
  rail
>
  <article itemscope itemtype="https://schema.org/BlogPosting">
    <h1
      itemprop="headline"
      class="max-w-[24ch] font-serif text-[clamp(28px,3.2vw,38px)] leading-[1.25] font-normal"
    >
      {title}
    </h1>
    <p class="mt-2.5 mb-9 text-xs tracking-[0.08em] text-faint uppercase">
      <time itemprop="datePublished" datetime={pubDate.toISOString()}>
        {formatDate(pubDate)}
      </time>
      {
        updatedDate && (
          <>
            {" · Updated "}
            <time itemprop="dateModified" datetime={updatedDate.toISOString()}>
              {formatDate(updatedDate)}
            </time>
          </>
        )
      }
    </p>

    {
      heroImage && (
        <Image
          src={heroImage}
          alt={title}
          class="mb-8 h-auto w-full"
          widths={[400, 800, 1200]}
          sizes="(max-width: 880px) 100vw, 640px"
        />
      )
    }

    <div class="post-body" itemprop="articleBody">
      <slot />
    </div>

    <nav
      class="mt-12 flex justify-between gap-[2ch] border-t border-rule pt-5 text-[13px]"
    >
      {
        previous ? (
          <a href={`/blog/${previous.id}/`}>&larr; {previous.title}</a>
        ) : (
          <span />
        )
      }
      {
        next ? (
          <a href={`/blog/${next.id}/`}>{next.title} &rarr;</a>
        ) : (
          <a href="/blog/">All writing &rarr;</a>
        )
      }
    </nav>
  </article>
</BaseLayout>
