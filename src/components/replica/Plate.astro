---
/**
 * One mode of Replica, hung on the site's own neutral wall: painted in its
 * base color regardless of the visitor's scheme, so both plates are always
 * on view. Swatches copy their hex on click.
 */
import { Code } from "astro:components";
import {
  color,
  replica,
  replicaBone,
  replicaCarbon,
  type Mode,
} from "../../lib/replica";

interface Props {
  mode: Mode;
  code: string;
}

const { mode, code } = Astro.props;
const { reproduction } = replica.modes[mode];
// The page already says Replica; the plate carries only the surface name.
const label = mode.charAt(0).toUpperCase() + mode.slice(1);
const p = (name: string) => color(mode, name);
const ramp = replica.neutrals;
---

<section
  class:list={[
    "plate",
    `plate-${mode}`,
    "rounded-sm px-6 py-6 md:px-8 md:py-8",
  ]}
  style={`background:${p("base")};color:${p("text")}`}
  aria-labelledby={`plate-${mode}`}
>
  <header class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
    <h3
      id={`plate-${mode}`}
      class="font-display text-[12.5px] font-bold tracking-[0.16em] uppercase"
    >
      {label}
    </h3>
    <p
      class="font-mono text-xs tracking-[0.08em]"
      style={`color:${p("subtle")}`}
    >
      {reproduction}
    </p>
  </header>

  <!-- Neutral ramp: nine steps from base to text. -->
  <ol class="mt-6 grid grid-cols-9 gap-px" aria-label="Neutrals">
    {
      ramp.map((t) => (
        <li>
          <button
            type="button"
            class="swatch block h-10 w-full cursor-copy"
            style={`background:${t[mode]};box-shadow:inset 0 0 0 1px ${p("highlightHigh")}`}
            data-hex={t[mode]}
            title={`${t.name} ${t[mode]}`}
            aria-label={`Copy ${t.name} ${t[mode]}`}
          />
        </li>
      ))
    }
  </ol>
  <div
    class="mt-1.5 flex justify-between font-mono text-[10.5px] tracking-[0.08em] uppercase"
    style={`color:${p("muted")}`}
  >
    <span>base</span><span>text</span>
  </div>

  <!-- Accents: six tiles. -->
  <ul class="mt-6 grid grid-cols-4 gap-3 md:grid-cols-6" aria-label="Accents">
    {
      replica.accents.map((t) => (
        <li>
          <button
            type="button"
            class="swatch block aspect-square w-full cursor-copy rounded-xs"
            style={`background:${t[mode]}`}
            data-hex={t[mode]}
            aria-label={`Copy ${t.name} ${t[mode]}`}
          />
          <div class="mt-1.5 font-mono text-[11px] leading-[1.5]">
            <div>{t.name}</div>
            <div style={`color:${p("subtle")}`}>{t[mode]}</div>
          </div>
        </li>
      ))
    }
  </ul>

  <div class="mt-6 text-[13px]">
    <Code
      code={code}
      lang="ts"
      themes={{ light: replicaBone, dark: replicaCarbon }}
      defaultColor={false}
    />
  </div>
</section>

<style>
  /* Shiki emits both palettes as variables (defaultColor is off); the plate,
     not the visitor's scheme, chooses. These outrank the site-wide
     prefers-color-scheme switch in global.css by specificity. */
  .plate-carbon :global(.astro-code),
  .plate-carbon :global(.astro-code span) {
    color: var(--shiki-dark) !important;
    background-color: var(--shiki-dark-bg) !important;
  }
  .plate-bone :global(.astro-code),
  .plate-bone :global(.astro-code span) {
    color: var(--shiki-light) !important;
    background-color: var(--shiki-light-bg) !important;
  }
  .plate :global(.astro-code) {
    margin: 0;
    padding: 1rem 1.25rem;
    overflow-x: auto;
    border-radius: 2px;
    line-height: 1.6;
  }
  .swatch:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }
  .swatch[data-copied]::after {
    content: "copied";
    position: absolute;
    inset-inline: 0;
    margin-top: -1.5rem;
    text-align: center;
    font: 10.5px/1 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  li {
    position: relative;
  }
</style>

<script>
  // Copy a swatch's hex; the ::after label confirms for a moment.
  document.querySelectorAll<HTMLButtonElement>(".swatch").forEach((el) => {
    el.addEventListener("click", async () => {
      const hex = el.dataset.hex;
      if (!hex) return;
      try {
        await navigator.clipboard.writeText(hex);
        el.setAttribute("data-copied", "");
        setTimeout(() => el.removeAttribute("data-copied"), 900);
      } catch {
        // Clipboard blocked; the hex is in the title and the tables below.
      }
    });
  });
</script>
