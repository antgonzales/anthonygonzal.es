---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Entry from "../components/Entry.astro";
import SectionLabel from "../components/SectionLabel.astro";
import { entryDate, getTechnicalPosts, readingTime } from "../lib/posts";
import { currentlyReading, finishedBooks } from "../lib/reading";
// Hand-maintained milestones, not content. Home Platform and Compass One
// point at their launch posts until /work and its case studies exist.
import record from "../data/record.json";
import { siteDescription } from "../data/site.json";

const latest = getTechnicalPosts(await getCollection("posts"), 4);
const books = await getCollection("reading");
const current = currentlyReading(books);
const finished = finishedBooks(books, 3);
---

<BaseLayout title="Anthony Gonzales" description={siteDescription}>
  {
    /* One paragraph at one size — the whole pitch is the heading. Links are
      italic rather than colored; v4 has no accent. */
  }
  <h1
    class="max-w-[46ch] font-serif text-[clamp(26px,3.4vw,38px)] leading-[1.3] font-normal"
  >
    Anthony Gonzales is a Staff Frontend Engineer at <a
      href="https://compass.com"
      class="italic">Compass</a
    >, building software for real estate agents. He <a
      href="/blog/"
      class="italic">writes about the work</a
    >: how it&rsquo;s architected, how it&rsquo;s built, and what he learns
    making it. He <a href="/reading/" class="italic">reads slowly</a>, with
    notes.
  </h1>

  <SectionLabel>Latest</SectionLabel>
  {
    latest.map((post) => {
      const date = entryDate(post.data.pubDate);
      return (
        <Entry
          date={date.line}
          year={date.year}
          title={post.data.title}
          href={`/blog/${post.id}/`}
          dek={post.data.description}
          meta={readingTime(post.body ?? "")}
        />
      );
    })
  }
  <a class="mt-5 inline-block text-[13px]" href="/blog/"
    >View all writing &rarr;</a
  >

  <SectionLabel>Record</SectionLabel>
  {
    record.map((item) => (
      <Entry
        date={item.year}
        title={item.title}
        href={item.href}
        who={item.who}
      />
    ))
  }

  <SectionLabel>Reading</SectionLabel>
  {
    current ? (
      <Entry date="NOW" title={current.data.title} who={current.data.author} />
    ) : null
  }
  {
    finished.map((book) => (
      <Entry
        date={String(book.data.finished!.getUTCFullYear())}
        title={book.data.title}
        who={book.data.author}
      />
    ))
  }
</BaseLayout>
