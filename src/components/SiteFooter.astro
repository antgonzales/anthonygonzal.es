---
// Rail and footer share one label per link — plain names, not URLs.
import { elsewhere, siteName } from "../data/site.json";

interface Props {
  /** The homepage has no rail, so it carries the Elsewhere links here. */
  links?: boolean;
}

const { links = false } = Astro.props;
const year = new Date().getFullYear();
---

<footer
  class="mt-16 flex justify-between gap-[2ch] border-t border-rule pt-5 pb-10 text-xs text-faint"
>
  <span>
    © {year}
    {siteName}{
      links
        ? elsewhere.map((item) => (
            <>
              {" · "}
              {/* set:text keeps the underline off the surrounding whitespace. */}
              <a href={item.href} class="text-inherit" set:text={item.label} />
            </>
          ))
        : null
    }
  </span>
  <span>
    Built with <a href="https://astro.build" class="text-inherit">Astro</a> · Hosted
    on <a href="https://pages.cloudflare.com" class="text-inherit">Cloudflare</a
    >
  </span>
</footer>
