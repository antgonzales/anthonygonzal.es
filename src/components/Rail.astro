---
import SectionLabel from "./SectionLabel.astro";
import { elsewhere } from "../data/site.json";
import { externalAttrs } from "../lib/links";

const compass = "https://compass.com";
---

<aside
  class="border-rule min-w-0 border-l pl-8 max-[880px]:mt-12 max-[880px]:border-l-0 max-[880px]:pt-8 max-[880px]:pl-0 [&_a]:decoration-faint [&_a]:decoration-[0.04em] [&_a]:underline-offset-[0.1em] [&_a:hover]:decoration-[0.04em] [&_a:hover]:decoration-ink"
>
  <section class="pb-7">
    <SectionLabel first display class="mb-2.5">About</SectionLabel>
    <p class="font-sans text-[15px] leading-[1.55]">
      Anthony Gonzales is a Staff Frontend Engineer at <a
        href={compass}
        {...externalAttrs(compass)}>Compass</a
      > in New York. He <a href="/blog/">writes about frontend systems</a>, and <a
        href="/reading/">takes notes as he reads</a
      >.
    </p>
  </section>

  <!-- currently-reading module slots here when the art/reading release ships -->

  <section class="py-7">
    <SectionLabel first display class="mb-2.5">Elsewhere</SectionLabel>
    <div class="text-[13px]">
      {
        elsewhere.map((item) => (
          <a class="block py-1" href={item.href} {...externalAttrs(item.href)}>
            {item.label}
          </a>
        ))
      }
    </div>
  </section>
</aside>
