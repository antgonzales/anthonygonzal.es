---
// `nav` is the header order. Add Work here when case studies ship:
//   { "label": "Work", "href": "/work/" }  — goes first, before Writing.
import { nav, siteName } from "../data/site.json";

const path = Astro.url.pathname;
// The homepage opens with the name in its own headline, so the wordmark
// would only say it twice. The nav keeps the right edge on its own.
const isHome = path === "/";
---

<header
  class="flex flex-wrap items-baseline justify-between gap-2 border-b border-ink pt-8 pb-4"
>
  {
    isHome ? null : (
      <a
        href="/"
        class="font-serif text-2xl font-normal no-underline hover:no-underline"
      >
        {siteName}
      </a>
    )
  }
  <nav class:list={["text-[13px]", isHome ? "ml-auto" : null]}>
    {
      nav.map((item, i) => {
        const current = path.startsWith(item.href);
        return (
          <>
            {i > 0 ? <span class="mx-[1ch] text-faint">/</span> : null}
            <a
              href={item.href}
              class:list={[
                "px-[2px] py-2",
                // Every link underlines now, so the current section can't be
                // marked by the line itself. It takes the ink decoration that
                // hover uses, against the faint default of its neighbours.
                current ? "decoration-ink" : null,
              ]}
              aria-current={current ? "page" : undefined}
            >
              {item.label}
            </a>
          </>
        );
      })
    }
  </nav>
</header>
