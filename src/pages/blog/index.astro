---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Entry from "../../components/Entry.astro";
import { byNewest, entryDate, readingTime } from "../../lib/posts";

const posts = byNewest(await getCollection("posts"));
---

<BaseLayout
  title="Writing"
  description="Everything Anthony Gonzales has written, newest first."
  rail
>
  <div class="mb-2">
    <h1 class="font-serif text-[34px] font-normal">Writing</h1>
    <p class="mt-2 text-[13px] text-faint">
      {posts.length} posts &middot; <a href="/rss.xml">RSS</a>
    </p>
  </div>
  {
    posts.map((post) => {
      const date = entryDate(post.data.pubDate);
      return (
        <Entry
          date={date.line}
          year={date.year}
          title={post.data.title}
          href={`/blog/${post.id}/`}
          dek={post.data.description}
          meta={readingTime(post.body ?? "")}
        />
      );
    })
  }
</BaseLayout>
