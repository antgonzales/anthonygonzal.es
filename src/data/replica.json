  "ports": [
    {
      "label": "Neovim",
      "href": "https://github.com/antgonzales/dotfiles/tree/main/nvim/.config/nvim/colors",
      "note": "colors/replica-carbon.lua and replica-bone.lua, generated by pnpm replica:ports"
    },
    {
      "label": "Ghostty",
      "href": "https://github.com/antgonzales/dotfiles/tree/main/ghostty/.config/ghostty/themes",
      "note": "themes/replica-carbon and replica-bone, generated by pnpm replica:ports"
    },
    {
      "label": "Shiki",
      "href": "https://github.com/antgonzales/anthonygonzal.es/blob/main/src/lib/replica.ts",
