---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Entry from "../components/Entry.astro";
import SectionLabel from "../components/SectionLabel.astro";
import { entryDate, getTechnicalPosts } from "../lib/posts";
import { currentlyReading, finishedBooks } from "../lib/reading";
// Hand-maintained milestones, not content. Home Platform and Compass One
// point at their launch posts until /work and its case studies exist.
import record from "../data/record.json";
import { siteDescription } from "../data/site.json";
import { externalAttrs } from "../lib/links";

const compass = "https://compass.com";

const latest = getTechnicalPosts(await getCollection("posts"), 6);
const books = await getCollection("reading");
const current = currentlyReading(books);
const finished = finishedBooks(books, 2);

const homepageTitles: Record<string, string> = {
  "how-to-test-react-router-components": "How to test React Router components",
  "how-to-solve-match-media-is-not-a-function":
    "Fix window.matchMedia is not a function in Jest",
};
---

<BaseLayout title="Anthony Gonzales" description={siteDescription}>
  <div class="pt-2">
    <h1
      class="font-display text-[clamp(44px,6vw,72px)] leading-[0.98] font-bold tracking-[-0.01em] uppercase"
    >
      Anthony<br /><span
        class="text-ink dark:text-ink-dark supports-[-webkit-text-stroke:1px_black]:text-transparent supports-[-webkit-text-stroke:1px_black]:[-webkit-text-stroke:2px_var(--color-ink)] dark:supports-[-webkit-text-stroke:1px_black]:[-webkit-text-stroke:2px_var(--color-ink-dark)]"
        >Gonzales</span
      >
    </h1>
    <p class="mt-6 max-w-measure text-[19px] leading-[1.55]">
      Staff Frontend Engineer in NYC, building software for real estate agents
      at <a href={compass} {...externalAttrs(compass)}>Compass</a>. He <a
        href="/blog/">writes about the work</a
      >: how it&rsquo;s architected, how it&rsquo;s built, and what he learns
      making it. He keeps <a href="/reading/">notes on what he reads</a>.
    </p>
  </div>

  <!-- (dés)ordres returns here with its writeup — see home-4.17.0 spec for the plinth treatment -->

  <div
    class="grid grid-cols-1 gap-x-18 pt-4 lg:grid-cols-[1fr_var(--container-rail)]"
  >
    <section>
      <SectionLabel display>Writing</SectionLabel>
      {
        latest.map((post) => (
          <Entry
            home
            date={entryDate(post.data.pubDate)}
            title={homepageTitles[post.id] ?? post.data.title}
            href={`/blog/${post.id}/`}
            dek={post.data.description}
          />
        ))
      }
      <a class="mt-5 inline-block font-mono text-[13px]" href="/blog/"
        >View all writing &rarr;</a
      >
    </section>

    <div class="lg:mt-0 max-lg:mt-4">
      <section>
        <SectionLabel display>Releases</SectionLabel>
        {
          record.map((item) => (
            <Entry
              home
              date={item.year}
              title={item.title}
              href={item.href}
              who={item.who}
            />
          ))
        }
      </section>

      <section>
        <SectionLabel display>Reading</SectionLabel>
        {
          current ? (
            <Entry
              home
              date="NOW"
              title={current.data.title}
              who={current.data.author}
            />
          ) : null
        }
        {
          finished.map((book) => (
            <Entry
              home
              date={String(book.data.finished!.getUTCFullYear())}
              title={book.data.title}
              who={book.data.author}
            />
          ))
        }
      </section>
    </div>
  </div>
</BaseLayout>
