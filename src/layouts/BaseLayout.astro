---
import "../styles/global.css";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import Rail from "../components/Rail.astro";
import { siteName } from "../data/site.json";

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  pubDate?: Date;
  updatedDate?: Date;
  rail?: boolean;
  /** Keep the page out of search results. For chrome-only routes like 404. */
  noindex?: boolean;
}

const {
  title,
  description,
  ogImage,
  pubDate,
  updatedDate,
  rail = false,
  noindex = false,
} = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const fullTitle = title === siteName ? title : `${title} · ${siteName}`;
---

<!doctype html>
<html lang="en" class="scheme-light-dark bg-paper">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link
      rel="preload"
      href="/fonts/SpaceGrotesk-700-subset.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={siteName}
      href="/rss.xml"
    />
    <link rel="canonical" href={canonicalURL} />
    {noindex ? <meta name="robots" content="noindex" /> : null}
    <meta name="generator" content={Astro.generator} />

    <title>{fullTitle}</title>
    {description ? <meta name="description" content={description} /> : null}

    <!-- Open Graph -->
    <meta property="og:type" content={pubDate ? "article" : "website"} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content={siteName} />
    {
      description ? (
        <meta property="og:description" content={description} />
      ) : null
    }
    {
      ogImage ? (
        <meta property="og:image" content={new URL(ogImage, Astro.site)} />
      ) : null
    }
    {
      pubDate ? (
        <meta
          property="article:published_time"
          content={pubDate.toISOString()}
        />
      ) : null
    }
    {
      updatedDate ? (
        <meta
          property="article:modified_time"
          content={updatedDate.toISOString()}
        />
      ) : null
    }

    <!-- Twitter card -->
    <meta
      name="twitter:card"
      content={ogImage ? "summary_large_image" : "summary"}
    />
    <meta name="twitter:title" content={fullTitle} />
    {
      description ? (
        <meta name="twitter:description" content={description} />
      ) : null
    }
    {
      ogImage ? (
        <meta name="twitter:image" content={new URL(ogImage, Astro.site)} />
      ) : null
    }
  </head>
  <body
    class:list={[
      // One shell on every route keeps the header and footer anchored while
      // the content between them changes shape. The min-height flex column
      // pins the footer to the viewport bottom on pages too short to fill it;
      // `main` takes the slack via flex-1. Width and gutters stay on this same
      // element, so centering is unaffected.
      "mx-auto flex min-h-screen max-w-[62rem] flex-col px-5 font-mono text-sm leading-[1.6] tabular-nums text-ink md:px-8",
    ]}
  >
    <SiteHeader />
    {
      rail ? (
        <main class="flex-1 grid grid-cols-1 gap-x-12 pt-14 min-[881px]:grid-cols-[minmax(0,1fr)_272px]">
          <div class="min-w-0">
            <slot />
          </div>
          <Rail />
        </main>
      ) : (
        <main class="flex-1 pt-12">
          <slot />
        </main>
      )
    }
    <SiteFooter showElsewhere={!rail} />
  </body>
</html>
