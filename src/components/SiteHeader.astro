---
import { nav, siteName } from "../data/site";

const path = Astro.url.pathname;
---

<header
  class="flex flex-wrap items-baseline justify-between gap-2 border-b border-ink pt-8 pb-4"
>
  <a
    href="/"
    class="font-serif text-2xl font-normal no-underline hover:no-underline"
    >{siteName}</a
  >
  <nav class="text-[13px]">
    {
      nav.map((item, i) => (
        <>
          {i > 0 && <span class="mx-[1ch] text-faint">/</span>}
          <a
            href={item.href}
            class:list={[
              "px-[2px] py-2 no-underline hover:underline",
              path.startsWith(item.href) &&
                "underline [text-underline-offset:6px]",
            ]}
            aria-current={path.startsWith(item.href) ? "page" : undefined}
          >
            {item.label}
          </a>
        </>
      ))
    }
  </nav>
</header>
