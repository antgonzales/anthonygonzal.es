      "#70a3ac",
      "#aa95a2",
      "#7aa492",
      "#dbd5cb"
    ],
    "bone": [
      "#3b3630",
      "#982820",
      "#4f642a",
      "#6f5b00",
      "#2e6470",
      "#6e5666",
      "#3a6554",
      "#eeebd9",
