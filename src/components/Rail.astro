---
import SectionLabel from "./SectionLabel.astro";
import { aboutBlurb, elsewhere } from "../data/site";
---

<aside
  class="border-rule pt-8 mt-12 border-t rail:mt-0 rail:border-t-0 rail:border-l rail:pt-0 rail:pl-8"
>
  <div class="pb-8">
    <SectionLabel first class="mb-2.5">About</SectionLabel>
    <p class="mb-1 font-serif text-[15px] leading-[1.55]">
      {aboutBlurb}
      <a href="/">More &rarr;</a>
    </p>
  </div>
  {
    /* Currently reading slots here when the reading collection has a book in
      progress: label "Currently reading" / serif title / mono author /
      started date. */
  }
  <div class="border-t border-rule pt-6 pb-8">
    <SectionLabel first class="mb-2.5">Elsewhere</SectionLabel>
    <div>
      {
        elsewhere.map((item) => (
          <a href={item.href} class="block py-1 text-[13px]">
            {item.label}
          </a>
        ))
      }
    </div>
  </div>
</aside>
