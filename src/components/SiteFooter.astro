---
// Interior rails own Elsewhere; only the rail-less homepage repeats those
// links in its footer. The chrome remains geometrically identical.
import { elsewhere, siteName } from "../data/site.json";
import { externalAttrs } from "../lib/links";

interface Props {
  showElsewhere?: boolean;
}

const { showElsewhere = false } = Astro.props;
const year = new Date().getFullYear();
const astroSite = "https://astro.build";
const cloudflare = "https://pages.cloudflare.com";
---

<footer
  class="mt-16 flex flex-wrap justify-between gap-x-[2ch] gap-y-1.5 pt-5 pb-10 font-mono text-xs text-faint dark:text-faint-dark max-sm:flex-col"
>
  <span>
    © {year}
    {siteName}{
      showElsewhere
        ? elsewhere.map((item) => (
            <>
              {" · "}
              {/* set:text keeps the underline off the surrounding whitespace. */}
              <a
                href={item.href}
                set:text={item.label}
                {...externalAttrs(item.href)}
              />
            </>
          ))
        : null
    }
  </span>
  <span>
    Built with <a href={astroSite} {...externalAttrs(astroSite)}>Astro</a> · Hosted
    on <a href={cloudflare} {...externalAttrs(cloudflare)}>Cloudflare</a>
  </span>
</footer>
