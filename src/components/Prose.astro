---
/**
 * The article body — markdown output and the hand-written About page.
 *
 * Generated markup cannot take utility classes, so the v4 prose scale is
 * expressed with Tailwind Typography's element variants instead of a
 * stylesheet: one line per element below. Typography's own rules are all
 * `:where()`, so every `prose-*` variant here wins without `!important`.
 *
 * Colors go through the `--tw-prose-*` hooks so prose tracks the same
 * light-dark() tokens as the rest of the site.
 */
interface Props {
  class?: string;
  [attr: string]: unknown;
}

const { class: className, ...attrs } = Astro.props;
---

<div
  class:list={[
    "prose max-w-none",

    // Palette. Every prose color resolves to a v4 token, so dark mode needs
    // no `-invert-` set — light-dark() has already handled it.
    "[--tw-prose-body:var(--color-ink)]",
    "[--tw-prose-headings:var(--color-ink)]",
    "[--tw-prose-links:var(--color-ink)]",
    "[--tw-prose-bold:var(--color-ink)]",
    "[--tw-prose-bullets:var(--color-ink)]",
    "[--tw-prose-counters:var(--color-ink)]",
    "[--tw-prose-code:var(--color-ink)]",
    "[--tw-prose-pre-code:var(--color-ink)]",
    "[--tw-prose-pre-bg:transparent]",
    "[--tw-prose-quotes:var(--color-faint)]",
    "[--tw-prose-quote-borders:var(--color-rule)]",
    "[--tw-prose-captions:var(--color-faint)]",
    "[--tw-prose-hr:var(--color-rule)]",
    "[--tw-prose-th-borders:var(--color-rule)]",
    "[--tw-prose-td-borders:var(--color-rule)]",

    // Body copy: serif, 17.5px, measured at 60ch.
    "prose-p:my-0 prose-p:mb-[1.3rem] prose-p:max-w-[60ch] prose-p:font-serif prose-p:text-[17.5px] prose-p:leading-[1.68]",

    // Lists share the body scale, with markers hung outside the measure.
    "prose-ul:my-0 prose-ul:mb-[1.3rem] prose-ul:max-w-[60ch] prose-ul:pl-6 prose-ul:font-serif prose-ul:text-[17.5px] prose-ul:leading-[1.68]",
    "prose-ol:my-0 prose-ol:mb-[1.3rem] prose-ol:max-w-[60ch] prose-ol:pl-6 prose-ol:font-serif prose-ol:text-[17.5px] prose-ol:leading-[1.68]",
    "prose-li:my-0 prose-li:mb-[0.4rem] prose-li:pl-0",
    // A nested list closes up against its parent item.
    "[&_li>ul]:mt-[0.4rem] [&_li>ul]:mb-0 [&_li>ol]:mt-[0.4rem] [&_li>ol]:mb-0",
    // Typography indents `li > p`; markdown loose lists must not double-space.
    "[&_li>p]:my-0",

    // Quotes are a hairline rule and a shift to faint — no italics, no
    // punctuation marks (Typography adds curly quotes by default).
    "prose-blockquote:my-0 prose-blockquote:mb-[1.3rem] prose-blockquote:max-w-[60ch] prose-blockquote:border-l prose-blockquote:border-rule prose-blockquote:pl-5 prose-blockquote:font-normal prose-blockquote:not-italic",
    "[&_blockquote_p]:text-faint [&_blockquote_p:first-of-type]:before:content-none [&_blockquote_p:last-of-type]:after:content-none",

    // Headings. h4 drops to the mono label voice used by SectionLabel.
    "prose-h2:mt-11 prose-h2:mb-4 prose-h2:font-serif prose-h2:text-[22px] prose-h2:font-normal",
    "prose-h3:mt-8 prose-h3:mb-3 prose-h3:font-serif prose-h3:text-[19px] prose-h3:font-normal",
    "prose-h4:mt-8 prose-h4:mb-3 prose-h4:text-[11px] prose-h4:font-normal prose-h4:tracking-[0.14em] prose-h4:uppercase",

    // Code. Inline code is marked by the mono face alone — no ink block, and
    // no backtick pseudo-elements.
    "prose-code:font-mono prose-code:text-[0.85em] prose-code:font-normal prose-code:before:content-none prose-code:after:content-none",
    "prose-pre:my-7 prose-pre:rounded-none prose-pre:border prose-pre:border-rule prose-pre:px-5 prose-pre:py-4 prose-pre:text-[13.5px] prose-pre:leading-[1.6]",

    // Links keep the site-wide underline treatment set on <body>; Typography
    // only needs its bolder weight walked back.
    "prose-a:font-normal",

    // Figures and rules.
    "prose-img:my-7 prose-hr:my-10 prose-hr:max-w-[60ch]",

    // Tables read as records: mono, uppercase heads, hairline rows.
    "prose-table:my-7 prose-table:text-[13px]",
    "prose-th:border-b prose-th:border-rule prose-th:py-2 prose-th:pr-6 prose-th:pl-0 prose-th:text-left prose-th:text-[11px] prose-th:font-normal prose-th:tracking-[0.14em] prose-th:uppercase",
    "prose-td:border-b prose-td:border-rule prose-td:py-2 prose-td:pr-6 prose-td:pl-0 prose-td:text-left",

    className,
  ]}
  {...attrs}
>
  <slot />
</div>
