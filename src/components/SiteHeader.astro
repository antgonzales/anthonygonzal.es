---
// `nav` is the header order. Add Work here when case studies ship:
//   { "label": "Work", "href": "/work/" }  — goes first, before Writing.
import { nav, siteName } from "../data/site.json";

const path = Astro.url.pathname;
---

<header
  class="flex flex-wrap items-baseline justify-between gap-2 border-b border-ink pt-8 pb-4"
>
  <a
    href="/"
    class="font-serif text-2xl font-normal no-underline hover:no-underline"
    >{siteName}</a
  >
  <nav class="text-[13px]">
    {
      nav.map((item, i) => {
        const current = path.startsWith(item.href);
        return (
          <>
            {i > 0 ? <span class="mx-[1ch] text-faint">/</span> : null}
            <a
              href={item.href}
              class:list={[
                "px-[2px] py-2 no-underline hover:underline",
                // The current section is the one nav item already wearing the
                // underline. It sits at the site's 3px offset like every other
                // link — a custom offset here detached it from the text on hover.
                current ? "underline" : null,
              ]}
              aria-current={current ? "page" : undefined}
            >
              {item.label}
            </a>
          </>
        );
      })
    }
  </nav>
</header>
