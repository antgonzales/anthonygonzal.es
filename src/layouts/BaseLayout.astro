---
import "../styles/global.css";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import Rail from "../components/Rail.astro";
import { siteName } from "../data/site.json";

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  pubDate?: Date;
  updatedDate?: Date;
  /** Interior pages get the two-column layout with the rail. */
  rail?: boolean;
}

const {
  title,
  description,
  ogImage,
  pubDate,
  updatedDate,
  rail = false,
} = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const fullTitle = title === siteName ? title : `${title} · ${siteName}`;
---

<!doctype html>
<html lang="en" class="scheme-light-dark bg-paper">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={siteName}
      href="/rss.xml"
    />
    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />

    <title>{fullTitle}</title>
    {description ? <meta name="description" content={description} /> : null}

    <!-- Open Graph -->
    <meta property="og:type" content={pubDate ? "article" : "website"} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content={siteName} />
    {
      description ? (
        <meta property="og:description" content={description} />
      ) : null
    }
    {
      ogImage ? (
        <meta property="og:image" content={new URL(ogImage, Astro.site)} />
      ) : null
    }
    {
      pubDate ? (
        <meta
          property="article:published_time"
          content={pubDate.toISOString()}
        />
      ) : null
    }
    {
      updatedDate ? (
        <meta
          property="article:modified_time"
          content={updatedDate.toISOString()}
        />
      ) : null
    }

    <!-- Twitter card -->
    <meta
      name="twitter:card"
      content={ogImage ? "summary_large_image" : "summary"}
    />
    <meta name="twitter:title" content={fullTitle} />
    {
      description ? (
        <meta name="twitter:description" content={description} />
      ) : null
    }
    {
      ogImage ? (
        <meta name="twitter:image" content={new URL(ogImage, Astro.site)} />
      ) : null
    }
  </head>
  <body
    class:list={[
      "mx-auto max-w-[69rem] px-5 font-mono text-sm leading-[1.6] tabular-nums text-ink md:px-8 lg:px-12",
      // The site-wide link treatment, in one place. Every property here is
      // inert while `text-decoration-line` is none, so links that opt out
      // with `no-underline` are untouched and no specificity fight follows.
      "[&_a]:decoration-faint [&_a]:underline-offset-[3px]",
      "[&_a:hover]:decoration-ink [&_a:hover]:decoration-2",
      "[&_a:focus-visible]:outline-2 [&_a:focus-visible]:outline-offset-2 [&_a:focus-visible]:outline-ink",
    ]}
  >
    <SiteHeader />
    {
      rail ? (
        <div class="grid grid-cols-1 gap-x-12 pt-12 rail:grid-cols-[1fr_272px]">
          <main class="min-w-0">
            <slot />
          </main>
          <Rail />
        </div>
      ) : (
        <main class="pt-12">
          <slot />
        </main>
      )
    }
    <SiteFooter links={!rail} />
  </body>
</html>
