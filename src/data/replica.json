{
  "name": "Replica",
  "version": "0.8.2",
  "description": "Earth pigments for the terminal and the editor. Two surfaces: Carbon, a terminal after midnight, and Bone, paper at noon.",
  "modes": {
    "carbon": {
      "displayName": "Replica Carbon",
      "type": "dark",
      "reproduction": "Reproduction of a terminal after midnight."
    },
    "bone": {
      "displayName": "Replica Bone",
      "type": "light",
      "reproduction": "Reproduction of paper at noon."
    }
  },
  "recipe": {
    "model": "WCAG 2 contrast ratio against base",
    "targets": {
      "syntax": 5,
      "oxide": 6,
      "text": 9,
      "subtle": 4.6,
      "muted": 3.8
    },
    "grounds": {
      "bone": {
        "hue": 45,
        "chroma": 0.024,
        "lightness": 0.901
      },
      "carbon": {
        "hue": 33,
        "chroma": 0.009,
        "lightness": 0.223
      }
    },
    "materials": {
      "clay": {
        "hue": 42,
        "chroma": 0.115
      },
      "flax": {
        "hue": 64,
        "chroma": 0.055
      },
      "sulfur": {
        "hue": 95,
        "chroma": 0.1
      },
      "resin": {
        "hue": 125,
        "chroma": 0.085
      },
      "sage": {
        "hue": 168,
        "chroma": 0.045
      },
      "slate": {
        "hue": 232,
        "chroma": 0.05
      },
      "ash": {
        "hue": 340,
        "chroma": 0.058
      },
      "oxide": {
        "hue": 28,
        "chroma": 0.15
      }
    },
    "derived": {
      "ansi16": "Slots 1 to 6 are oxide, resin, sulfur, slate, ash, sage. Slot 0 is overlay in Carbon and text in Bone; 7 is text in Carbon and surface in Bone; 8 is subtle; 15 is text lifted 12% toward white in Carbon and base in Bone. Bright 9 to 14 mix each material 14% toward white in Carbon and 12% toward black in Bone.",
      "diff": "Backgrounds mix base toward resin (add), oxide (delete) and slate (change, text): 16%, 16%, 12%, 24% in Carbon; 18%, 18%, 14%, 26% in Bone."
    }
  },
  "neutrals": [
    {
      "name": "base",
      "role": "Background",
      "carbon": "#1e1b18",
      "bone": "#e4e1cf"
    },
    {
      "name": "surface",
      "role": "Panels, status line, gutters",
      "carbon": "#262220",
      "bone": "#eeebd9"
    },
    {
      "name": "overlay",
      "role": "Floating windows, menus",
      "carbon": "#2c2823",
      "bone": "#f6f4e1"
    },
    {
      "name": "highlightLow",
      "role": "Cursor line",
      "carbon": "#24211d",
      "bone": "#dedbc9"
    },
    {
      "name": "highlightMed",
      "role": "Selection",
      "carbon": "#312c27",
      "bone": "#d1cdbc"
    },
    {
      "name": "highlightHigh",
      "role": "Borders, matching brackets",
      "carbon": "#3d3730",
      "bone": "#beb9aa"
    },
    {
      "name": "muted",
      "role": "Line numbers, whitespace",
      "carbon": "#7d766c",
      "bone": "#716f66"
    },
    {
      "name": "subtle",
      "role": "Punctuation, operators",
      "carbon": "#9c948a",
      "bone": "#64625a"
    },
    {
      "name": "text",
      "role": "Text, variables",
      "carbon": "#d6cfc4",
      "bone": "#3b3630"
    }
  ],
  "accents": [
    {
      "name": "clay",
      "role": "Keywords, headings",
      "ansi": null,
      "carbon": "#c67752",
      "bone": "#944726"
    },
    {
      "name": "flax",
      "role": "Strings, attributes",
      "ansi": null,
      "carbon": "#9f8766",
      "bone": "#72583b"
    },
    {
      "name": "sulfur",
      "role": "Constants, numbers, warnings",
      "ansi": "yellow",
      "carbon": "#9c8b3c",
      "bone": "#6f5b00"
    },
    {
      "name": "resin",
      "role": "Types, tags, insertions",
      "ansi": "green",
      "carbon": "#7a9356",
      "bone": "#4f642a"
    },
    {
      "name": "sage",
      "role": "Terminal cyan",
      "ansi": "cyan",
      "carbon": "#649580",
      "bone": "#3a6554"
    },
    {
      "name": "slate",
      "role": "Functions, cursor, info",
      "ansi": "blue",
      "carbon": "#59949e",
      "bone": "#2e6470"
    },
    {
      "name": "ash",
      "role": "Comments, hints",
      "ansi": "magenta",
      "carbon": "#9c8493",
      "bone": "#6e5666"
    },
    {
      "name": "oxide",
      "role": "Errors, deletions",
      "ansi": "red",
      "carbon": "#ea7866",
      "bone": "#982820"
    }
  ],
  "ansi16": {
    "carbon": [
      "#2c2823",
