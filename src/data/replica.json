  "diff": {
    "carbon": {
      "add": "#2d2e22",
      "delete": "#3f2a24",
      "change": "#252a28",
      "text": "#2c3838"
    },
    "bone": {
      "add": "#c9cbb1",
      "delete": "#d6c0b0",
      "change": "#cbd0c2",
      "text": "#b5c1b6"
