---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Entry from "../../components/Entry.astro";
import SectionLabel from "../../components/SectionLabel.astro";
import { monthYear } from "../../lib/posts";
import { currentlyReading, finishedBooks } from "../../lib/reading";

const books = await getCollection("reading");
const current = currentlyReading(books);
const finished = finishedBooks(books);
---

<BaseLayout
  title="Reading"
  description="What Anthony Gonzales is reading, and what he has finished."
  rail
>
  <h1 class="mb-2 font-serif text-[34px] font-normal">Reading</h1>

  {
    current ? (
      <>
        <SectionLabel>Currently</SectionLabel>
        <Entry
          date="NOW"
          title={current.data.title}
          who={current.data.author}
          href={current.data.note ? `/blog/${current.data.note}/` : undefined}
        />
      </>
    ) : null
  }

  <SectionLabel>Finished</SectionLabel>
  {
    finished.map((book) => {
      const date = monthYear(book.data.finished!);
      return (
        <Entry
          date={date.line}
          year={date.year}
          title={book.data.title}
          who={book.data.author}
          href={book.data.note ? `/blog/${book.data.note}/` : undefined}
        />
      );
    })
  }
  {/* Dithered dual-mode book covers slot in here later, via <picture>. */}
</BaseLayout>
