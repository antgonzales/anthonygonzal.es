{
  "name": "ink-paper",
  "displayName": "Ink Paper",
  "type": "light",
  "colors": {
    "editor.background": "#efede5",
    "editor.foreground": "#1f1e1c",
    "editor.selectionBackground": "#eae7de",
    "editor.selectionHighlightBackground": "#e2ded2",
    "editorCursor.foreground": "#556063",
    "editorLineNumber.foreground": "#8a877f",
    "editorWhitespace.foreground": "#dcd9d1"
  },
  "settings": [
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#8a877f", "fontStyle": "italic" }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "storage",
        "storage.type",
        "storage.modifier"
      ],
      "settings": { "foreground": "#9a5b3c" }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": { "foreground": "#7a5c3e" }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "support.constant"
      ],
      "settings": { "foreground": "#8a6d2f" }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "storage.type.class"
      ],
      "settings": { "foreground": "#5f6142" }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "variable.function",
        "meta.function-call"
      ],
      "settings": { "foreground": "#556063" }
    },
    {
      "scope": [
        "variable",
        "variable.other",
        "variable.parameter",
        "support.variable",
        "meta.object-literal.key",
        "entity.other.attribute-name"
      ],
      "settings": { "foreground": "#1f1e1c" }
    },
    {
      "scope": ["punctuation", "meta.brace", "meta.delimiter"],
      "settings": { "foreground": "#8a877f" }
    },
    {
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#9a5b3c", "fontStyle": "underline" }
    }
  ]
}
