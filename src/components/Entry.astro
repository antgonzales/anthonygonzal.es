---
/**
 * The one entry grammar: a small-caps date line, the sans title beneath it,
 * then the dek. Block layout — no date column, no right-hand meta cell.
 * Used by the homepage lists, the writing index, and the reading page.
 */
interface Props {
  /** One line, already formatted — "AUG 10, 2026", "JUL 2026", "2019", "NOW". */
  date: string;
  title: string;
  /** Record entries carry an explicit null when there is nothing to link to. */
  href?: string | null;
  /** Description sub-line, in faint. */
  dek?: string;
  /** Mono sub-line, in faint — author, role, context. */
  who?: string;
  /** Homepage register: sans titles/deks with slightly tighter spacing. */
  home?: boolean;
}

const { date, title, href, dek, who, home = false } = Astro.props;
---

<article class="py-7">
  <div class="mb-[7px] text-xs tracking-[0.08em] text-faint uppercase">
    {date}
  </div>
  <h3
    class="font-sans text-[19px] leading-[1.3] font-semibold tracking-[-0.01em]"
  >
    {
      href ? (
        <a
          href={href}
          class="decoration-faint decoration-[0.04em] underline-offset-[0.1em] hover:decoration-[0.04em] hover:decoration-ink"
        >
          {title}
        </a>
      ) : (
        title
      )
    }
  </h3>
  {
    dek ? (
      <p
        class:list={[
          "mt-1.5 text-faint",
          home
            ? "font-sans text-[13.5px] leading-[1.6]"
            : "font-mono text-[13.5px] leading-[1.6]",
        ]}
      >
        {dek}
      </p>
    ) : null
  }
  {
    who ? (
      <p
        class:list={[
          "mt-1 text-faint",
          home
            ? "font-sans text-[13.5px] leading-[1.6]"
            : "font-mono text-[13px]",
        ]}
      >
        {who}
      </p>
    ) : null
  }
</article>
