  "changelog": [
    {
      "version": "0.8.2",
      "date": "2026-09-13",
      "notes": "Rebuild the materials as one hue and chroma each, with Bone and Carbon lightness solved for equal contrast. Sulfur and flax stop glowing in Carbon. Sage moves toward teal. Slate moves to steel, oxide to rust. Bone moves from peach to cream. Bone gutters come up to 3.8:1."
    },
    {
      "version": "0.7.0",
      "date": "2026-09-07",
      "notes": "Name the terminal cyan sage. Move the palette's source of truth to replica.json on this site."
    },
    {
      "version": "0.6.0",
      "date": "2026-09-02",
      "notes": "Generate Neovim and Ghostty ports from the palette after hand-derived Ghostty values drifted in 12 of 16 ANSI slots."
    },
    {
      "version": "0.5.0",
      "date": "2026-08-29",
      "notes": "Adopt Replica Bone and Carbon for this site's code blocks, replacing Ink."
    }
  ]
}
