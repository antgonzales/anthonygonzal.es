---
interface Props {
  /** Section labels sit flush to the top when they open a column. */
  first?: boolean;
  display?: boolean;
  class?: string;
}

const { first = false, display = false, class: className } = Astro.props;
---

<h2
  class:list={[
    "border-b border-rule pb-2 uppercase",
    display
      ? "font-display text-[12.5px] font-bold tracking-[0.16em]"
      : "text-[11px] font-normal tracking-[0.14em]",
    first ? "mt-0" : "mt-18",
    className,
  ]}
>
  <slot />
</h2>
